MCP_TOKEN=CHANGE_ME
OAUTH_CLIENT_ID=CHANGE_ME
OAUTH_CLIENT_SECRET=CHANGE_ME
PORT=CHANGE_ME
# Gunakan 127.0.0.1 bila service hanya dipublikasikan melalui Cloudflare Tunnel.
BIND_HOST=127.0.0.1
APPROVE_PASSWORD=CHANGE_ME
# Screenshot visual hanya melalui reverse ADB loopback; host sengaja dikunci ke 127.0.0.1.
ADB_TUNNEL_HOST=127.0.0.1
ADB_TUNNEL_PORT=15037
# Root gambar yang boleh dibaca sebagai MCP ImageContent. Pisahkan dengan koma; jangan gunakan / atau /home secara umum.
IMAGE_READ_ALLOWED_ROOTS=/tmp,/home/safara/backups,/home/safara/projects/safara/safaraojolnative-deploy/native/assets,/home/safara/projects/safara/laundry-development/native/assets
