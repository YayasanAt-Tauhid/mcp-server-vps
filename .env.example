# MCP server identity/auth. Copy to .env and replace CHANGE_ME locally on the VPS.
MCP_TOKEN=
APPROVE_PASSWORD=SET_ME

# HTTP endpoint. Prefer loopback when published through Cloudflare Tunnel/reverse proxy.
PORT=3100
BIND_HOST=127.0.0.1
BASE_URL=https://mcp.example.com

# Optional reverse ADB tunnel. Host is intentionally loopback-only.
ADB_TUNNEL_HOST=127.0.0.1
ADB_TUNNEL_PORT=15037

# Generic browser smoke defaults. Public project domains belong in ssh_project profiles.
BROWSER_SMOKE_ALLOWED_HOSTS=127.0.0.1,localhost
BROWSER_SMOKE_LOCAL_PORTS=3100
BROWSER_SMOKE_BROWSERS_PATH=/opt/mcp-development/playwright-browsers

# Limit parallel workspace verification on small VPS instances.
WORKSPACE_VERIFY_CONCURRENCY=2

# Legacy/global file roots. Keep narrow. Project-specific roots belong in ssh_project profiles.
# Empty UPLOAD_ALLOWED_ROOTS disables generic browser upload slots until explicitly configured.
UPLOAD_ALLOWED_ROOTS=
IMAGE_READ_ALLOWED_ROOTS=/tmp

# Optional shared browser: install noVNC/VNC + sandboxed Chromium first.
SHARED_BROWSER_ENABLED=false
# Generate a random 32-byte signing key locally; never commit its value.
SHARED_BROWSER_SIGNING_KEY=
BROWSER_CDP_URL=http://127.0.0.1:9222
