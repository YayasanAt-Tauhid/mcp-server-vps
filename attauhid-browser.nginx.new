server {
    listen 127.0.0.1:6081;
    server_name browser-vps.hijrah-attauhid.or.id;
    auth_basic "Browser At-Tauhid";
    auth_basic_user_file /etc/nginx/attauhid-browser.htpasswd;

    location = /browser/vnc.html {
        auth_basic off;
        return 302 /embed/login;
    }

    location = /embed/login {
        auth_basic off;
        proxy_pass http://127.0.0.1:6082/embed/login;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header Cookie $http_cookie;
    }

    location = /embed/view {
        auth_basic off;
        proxy_pass http://127.0.0.1:6082/view;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header Cookie $http_cookie;
    }

    location = /embed/mode {
        auth_basic off;
        proxy_pass http://127.0.0.1:6082/mode;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header Cookie $http_cookie;
    }

    location = /embed/_auth {
        internal;
        auth_basic off;
        proxy_pass http://127.0.0.1:6082/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    location /embed/ {
        auth_basic off;
        auth_request /embed/_auth;
        error_page 401 =302 https://browser-vps.hijrah-attauhid.or.id/embed/login;
        rewrite ^/embed/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:6080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location /browser/ {
        rewrite ^/browser/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:6080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /browser { return 302 /browser/vnc.html; }
    location / { return 404; }
}
